.wrap { padding: 80rpx 40rpx 0; }
.logo { text-align: center; margin-bottom: 60rpx; }
.logo-text { font-size: 56rpx; font-weight: 800; color: #2f54eb; }
.logo-sub { display: block; margin-top: 12rpx; font-size: 26rpx; color: #9aa3b2; }
.tabs { display: flex; margin-bottom: 30rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; color: #6b7280; border-bottom: 4rpx solid #e5e7eb; }
.tab.active { color: #2f54eb; border-bottom-color: #2f54eb; font-weight: 600; }
.field { margin-bottom: 24rpx; }
.label { display: block; font-size: 24rpx; color: #6b7280; margin-bottom: 8rpx; }
.input { background: #f5f7fa; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.submit { margin-top: 30rpx; }
.divider { display: flex; align-items: center; margin: 30rpx 0 6rpx; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1rpx; background: #e5e7eb; }
.divider text { padding: 0 20rpx; font-size: 24rpx; color: #9ca3af; }
.btn-wechat { background: #07c160; color: #fff; border-radius: 12rpx; font-size: 30rpx; margin-top: 20rpx; }
.btn-wechat::after { border: none; }
.btn-wechat[loading] { background: #06ad56; }
.btn-wechat .wx-icon { display: inline-block; width: 40rpx; height: 40rpx; line-height: 40rpx; margin-right: 12rpx; border-radius: 8rpx; background: rgba(255,255,255,.25); font-size: 24rpx; }
.tip { margin-top: 20rpx; font-size: 22rpx; color: #9ca3af; text-align: center; }
